+            a, b = slabs[i], slabs[j]
+            pa, pb = polys[i], polys[j]
+            if pa is None or pb is None or a.get("priority") is None \
+                    or a.get("priority") != b.get("priority"):
+                continue
+            if (a.get("thickness") or 0) == (b.get("thickness") or 0):
+                continue
+            if pa.intersection(pb).area < 0.05:
+                continue
+            small = a if pa.area < pb.area else b
+            small["priority"] = int(small["priority"]) + 1
+            n += 1
+    return {"overlapping areas given a higher priority": n} if n else {}
+
+
+def mesh_doctor(site, job=None, level=0):
+    """
+    إصلاح الهندسة قبل البناء في RAM. بيعدّل site في مكانه وبيرجّع تقرير.
+    كل خطوة لوحدها في try: الدكتور عمره ما يوقف البناء.
+    """
+    lv = MESH_DOCTOR_LEVELS[max(0, min(level, len(MESH_DOCTOR_LEVELS) - 1))]
+    G = _md_geom()
+    rep = {}
+
+    def _do(label, fn):
+        try:
+            r = fn()
+            if isinstance(r, dict):
+                rep.update({k: v for k, v in r.items() if v})
+            elif r:
+                rep[label] = r
+        except Exception as e:
+            if job:
+                job.warn(f"Mesh doctor: {label} skipped ({type(e).__name__}: {e})")
+
+    _do("vertices closer than %.0f mm merged" % (lv["merge"] * 1000),
+        lambda: _md_merge_vertices(site, lv["merge"]))
+    _do("edges shorter than %.0f mm removed" % (lv["edge"] * 1000),
+        lambda: _md_clean_rings(site, lv["edge"]))
+    if G is not None:
+        _do("slab edge vertices moved onto the outer face of the edge beam",
+            lambda: _md_snap_to_faces(site, lv["snap"], G))
+        _do("openings", lambda: _md_openings_and_slivers(site, lv["sliver"], G, job))
+        _do("beams", lambda: _md_trim_beams(site, G))
+        _do("priorities", lambda: _md_same_priority(site, G))
+    elif job and level == 0:
+        job.warn("Mesh doctor: shapely is not installed, so only vertex and "
+                 "edge fixes ran ('pip install shapely' for the full set).")
+    _do("beam gaps", lambda: _md_close_beam_gaps(site, lv["snap"]))
+    _do("edges shorter than %.0f mm removed (after the fixes)" % (lv["edge"] * 1000),
+        lambda: _md_clean_rings(site, lv["edge"]))
+    if job:
+        if rep:
+            job.ok(f"Mesh doctor (level {level}): fixed before RAM sees it:")
+            for k, v in rep.items():
+                job.info(f"    · {k}: {v}")
+        else:
+            job.ok(f"Mesh doctor (level {level}): the geometry is clean.")
+    return rep
+
+
+def mesh_doctor_findings(site, limit=12):
+    """
+    الأماكن المشكوك فيها بالإحداثيات - لما RAM يرفض وكل الإصلاحات فشلت،
+    الرسالة لازم تقول فين.
+    """
+    out = []
+    for name, get, _put in _md_rings(site):
+        pts = get() or []
+        n = len(pts)
+        for i in range(n):
+            e = dist(pts[i], pts[(i + 1) % n])
+            if e < 0.15:
+                out.append((e, f"{name}: edge {e * 1000:.0f} mm at "
+                               f"({pts[i][0]:.2f}, {pts[i][1]:.2f})"))
+        for i in range(n):
+            a, b, c = pts[i - 1], pts[i], pts[(i + 1) % n]
+            v1 = (a[0] - b[0], a[1] - b[1])
+            v2 = (c[0] - b[0], c[1] - b[1])
+            l1, l2 = math.hypot(*v1), math.hypot(*v2)
+            if l1 < 1e-9 or l2 < 1e-9:
+                continue
+            cosang = max(-1.0, min(1.0, (v1[0] * v2[0] + v1[1] * v2[1]) / (l1 * l2)))
+            ang = math.degrees(math.acos(cosang))
+            if ang < 8.0:
+                out.append((ang / 100.0, f"{name}: spike of {ang:.1f}° at "
+                                         f"({b[0]:.2f}, {b[1]:.2f})"))
+    G = _md_geom()
+    if G is not None and site.get("boundary"):
+        B = _md_poly(G, site["boundary"])
+        if B is not None:
+            for k, m, a, b, half in _md_members(site):
+                #  كمرة ماشية بطول الحد (الطرفين على نفس البعد تقريبًا)
+                q1 = G[2](a[0] * 0.75 + b[0] * 0.25, a[1] * 0.75 + b[1] * 0.25)
+                q2 = G[2](a[0] * 0.25 + b[0] * 0.75, a[1] * 0.25 + b[1] * 0.75)
+                da, db = q1.distance(B.exterior), q2.distance(B.exterior)
+                d = min(da, db)
+                if half + 0.005 < d < half + 0.20 and abs(da - db) < 0.05 and B.contains(q1):
+                    out.append((d, f"{k[:-1]} ({a[0]:.2f}, {a[1]:.2f})-({b[0]:.2f}, "
+                                   f"{b[1]:.2f}): outer face {(d - half) * 1000:.0f} mm "
+                                   f"from the slab edge"))
+            sup = [G[2](c["center"]).buffer(0.5) for c in site.get("columns") or [] if c.get("center")]
+            sup += [G[1]([w["p1"], w["p2"]]).buffer(0.3) for w in site.get("walls") or []]
+            if sup:
+                S = G[4](sup)
+                for i, s in enumerate(site.get("slabs") or []):
+                    g = _md_poly(G, s["points"])
+                    if g is not None and not s.get("is_drop") and g.area > 5 and not g.intersects(S):
+                        c = g.representative_point()
+                        out.append((0.0, f"slab {i + 1} near ({c.x:.2f}, {c.y:.2f}) "
+                                         f"has no column or wall under it"))
+    out.sort(key=lambda r: r[0])
+    return [r[1] for r in out[:limit]]
+
