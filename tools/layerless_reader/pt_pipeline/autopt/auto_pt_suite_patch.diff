+class _RecordingLayer:
+    """
+    طبقة المنشأ بس بتفتكر كل عنصر اتضاف من البرنامج - عشان إعادة البناء
+    تمسح اللي البرنامج رسمه بس، ومايقربش من حاجة كانت في الـ template.
+    """
+
+    def __init__(self, layer, sink):
+        object.__setattr__(self, "_layer", layer)
+        object.__setattr__(self, "_sink", sink)
+
+    def __getattr__(self, name):
+        v = getattr(self._layer, name)
+        if name.startswith("add_") and callable(v):
+            def rec(*a, **k):
+                r = v(*a, **k)
+                if r is not None:
+                    self._sink.append(r)
+                return r
+            return rec
+        return v
+
+    def __setattr__(self, name, value):
+        setattr(self._layer, name, value)
+
+
+def _rebuild_structure(session, job, level):
+    """
+    امسح العناصر اللي البرنامج رسمها، وصلّح بمستوى أعلى، وارسم تاني.
+    لو فيه عنصر مالوش delete، مابيبدأش خالص: نص موديل ممسوح أسوأ من الغلط.
+    """
+    saved = getattr(session, "_autopt_site", None)
+    added = getattr(session, "_autopt_added", None)
+    if not saved or not added:
+        return False, "the structure was not drawn by this run"
+    if not all(callable(getattr(e, "delete", None)) for e in added):
+        return False, "this RAM API cannot delete elements"
+    for e in list(added):
+        try:
+            e.delete()
+        except Exception as ex:
+            job.error(f"Mesh doctor: deleting an element failed ({ex}) - the "
+                      f"structure layer may be incomplete.")
+            return False, "delete failed"
+    added.clear()
+    site, params = saved
+    session._mesh_level = level
+    build_structure_in_ram(session, site, params, job)
+    return True, f"structure rebuilt with the level-{level} fixes"
+
+
+def mesh_doctor_retry(session, job, mesh_size, first, once):
+    """
+    RAM رفض: صنّف السبب، صلّح، وأعد المحاولة. `once(size)` بيولّد الشبكة
+    ويحلّل مرة واحدة.
+    """
+    if getattr(session, "_md_active", False):
+        return first
+    text = " ".join(str(x) for x in [first.get("error") or ""] +
+                    list(getattr(session, "_last_mesh_errors", []) or []))
+    kind, why = diagnose_ram_error(text)
+    job.warn(f"Mesh doctor: RAM refused the model - {kind}: {why}.")
+    session._md_active = True
+    tried = []
+    try:
+        if kind in ("geometry", "overlap", "mesh", "unknown"):
+            for level in range(max(1, getattr(session, "_mesh_level", 0) + 1),
+                               len(MESH_DOCTOR_LEVELS)):
+                ok, what = _rebuild_structure(session, job, level)
+                if not ok:
+                    job.warn(f"Mesh doctor: cannot rebuild ({what}).")
+                    break
+                tried.append(what)
+                r = once(mesh_size)
+                if r.get("ok"):
+                    job.ok(f"Mesh doctor: fixed - {what}.")
+                    r["fixed_by"] = what
+                    return r
+        if kind != "stability":
+            base = float(mesh_size) if mesh_size else None
+            sizes = ([base * 0.75, base * 0.5, base * 1.5] if base
+                     else [1.0, 0.75, 0.5])
+            for s in sizes:
+                what = f"mesh element size {s:.2f} m"
+                tried.append(what)
+                r = once(round(s, 3))
+                if r.get("ok"):
+                    job.ok(f"Mesh doctor: fixed - {what}. Use this size for "
+                           f"this model.")
+                    r["fixed_by"] = what
+                    return r
+    finally:
+        session._md_active = False
+    job.error(f"Mesh doctor: RAM still refuses after: "
+              f"{'; '.join(tried) or 'no automatic fix applies'}.")
+    saved = getattr(session, "_autopt_site", None)
+    if saved:
+        spots = mesh_doctor_findings(saved[0])
+        if spots:
+            job.error("Check these places in the DXF:")
+            for s in spots:
+                job.error(f"    · {s}")
+    out = dict(first)
+    out["diagnosis"] = {"kind": kind, "why": why, "tried": tried}
+    return out
+
