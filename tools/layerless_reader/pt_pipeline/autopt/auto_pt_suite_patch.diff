+                new.append(p)
+                continue
+            cand.sort(key=lambda c: c[0])
+            _d, a, u, n, half, t = cand[0]
+            q = (a[0] + u[0] * t + n[0] * half, a[1] + u[1] * t + n[1] * half)
+            for _d2, a2, u2, n2, h2, _t2 in cand[1:]:
+                den = u[0] * u2[1] - u[1] * u2[0]
+                if abs(den) < 0.2:
+                    continue          # متوازيين: الأقرب كفاية
+                o1 = (a[0] + n[0] * half, a[1] + n[1] * half)
