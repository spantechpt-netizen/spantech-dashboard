+def read_area_notes(doc, scale):
+    """
+    ملاحظات لكل منطقة بلاطة (الملف النضيف بيكتبها جوه المنطقة نفسها):
+      "t=400"          -> سُمك المنطقة دي بالمم
+      "SE=+300"        -> Service/Surface Elevation: فرق منسوب سطحها عن
+                          سطح البلاطة الأساسية بالمم (+ لفوق، - لتحت)
+    النص بيروح لأصغر منطقة واقع جواها (دروب جوه بلاطة -> للدروب).
+      "POUR STRIP t=220 P=3 RELEASE FX FY" -> شريحة صب: أولوية صريحة + فك Fx/Fy
+    بترجع [(x, y, t_mm|None, se_mm|None, zone, priority|None, (fx, fy))].
+    """
+    out = []
+    for entity, _layer in _iter_entities(doc.modelspace()):
+        if entity.dxftype() not in ("TEXT", "MTEXT"):
+            continue
+        try:
+            ip = safe_get(entity.dxf, "insert") or safe_get(entity.dxf, "align_point")
+            raw_txt = safe_get(entity, "text", None) or safe_get(entity.dxf, "text", "")
+            txt = clean_mtext(raw_txt) if raw_txt else ""
+        except Exception:
+            continue
+        if ip is None or not txt or BEAM_LABEL_RE.search(txt):
+            continue                      # تسمية كمرة ليها قراءتها لوحدها
+        mt, ms = AREA_T_RE.search(txt), AREA_SE_RE.search(txt)
+        mp, mr = AREA_P_RE.search(txt), AREA_RELEASE_RE.search(txt)
+        rel = (False, False)
+        if mr:
+            dirs = (mr.group(1) or "").upper()
+            rel = ("FX" in dirs or not dirs.strip(), "FY" in dirs or not dirs.strip())
+        if mt or ms or mr:
+            out.append((float(ip[0]) * scale, float(ip[1]) * scale,
+                        float(mt.group(1)) if mt else None,
+                        float(ms.group(1)) if ms else None,
+                        bool(AREA_ZONE_RE.search(txt)),
+                        int(mp.group(1)) if mp else None,
+                        rel))
+    return out
+
