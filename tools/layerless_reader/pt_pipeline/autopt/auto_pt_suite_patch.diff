+def _md_merge_vertices(site, tol):
+    """
+    الرؤوس اللي بينها أقل من tol (في أي مضلع) بتبقى رأس واحد.
+    الحد الخارجي الأول، فرؤوسه هي المرجع.
+    """
+    cell = max(tol, 1e-6)
+    grid, moved = {}, 0
+    for _name, get, put in _md_rings(site):
+        pts = get()
+        if not pts:
+            continue
+        new = []
+        for p in pts:
+            p = (float(p[0]), float(p[1]))
+            gx, gy = int(math.floor(p[0] / cell)), int(math.floor(p[1] / cell))
+            hit = None
+            for dx in (-1, 0, 1):
+                for dy in (-1, 0, 1):
+                    for q in grid.get((gx + dx, gy + dy), ()):
+                        if dist(p, q) <= tol and (hit is None or
+                                                  dist(p, q) < dist(p, hit)):
+                            hit = q
+            if hit is None:
+                grid.setdefault((gx, gy), []).append(p)
+                new.append(p)
+            else:
+                if dist(p, hit) > 1e-9:
+                    moved += 1
+                new.append(hit)
+        put(new)
+    return moved
