+    خطين فرق منسوب (من غير أعمدة جواها) مابتطلعلهاش إطارات في الاتجاه
+    الموازي للكمرات. لو المنطقة مافيهاش ولا بحر في اتجاه، بيتحط خط في
+    نصها في الاتجاه ده، جوه المنطقة بس (مابيعدّيش خط الفرق).
+    """
+    if not subs:
+        return lines
+    try:
+        from shapely.geometry import Polygon as _P, LineString as _L
+    except Exception:
+        return lines
+    import math as _m
+    base = _m.radians(float(getattr(params, "strip_base_angle", 0.0) or 0.0))
+    min_span = max(float(getattr(params, "strip_min_span", 2.0) or 0.0), 0.5)
+    added = []
+    for sub in subs:
+        R = _P(sub["boundary"]).buffer(0)
+        for o in sub.get("openings") or []:
+            try:
