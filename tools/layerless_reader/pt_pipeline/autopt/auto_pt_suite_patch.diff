+            s2 = poly.contains(Pt(mid[0] - n[0] * off, mid[1] - n[1] * off))
+            if s1 == s2:
+                continue          # كمرة داخلية أو برّه خالص
+            if s1:
+                n = (-n[0], -n[1])
