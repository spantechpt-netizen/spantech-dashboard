+def _md_rings(site):
+    """كل المضلعات اللي بتتشبّك: (اسم، getter، setter)."""
+    out = []
+    if site.get("boundary"):
+        out.append(("boundary", lambda: site["boundary"],
+                    lambda v: site.__setitem__("boundary", v)))
+    for i, s in enumerate(site.get("slabs") or []):
+        out.append((f"slab {i + 1}", lambda s=s: s["points"],
+                    lambda v, s=s: s.__setitem__("points", v)))
+    for key in ("openings", "pour_strips"):
+        lst = site.get(key) or []
+        for i in range(len(lst)):
+            out.append((f"{key[:-1].replace('_', ' ')} {i + 1}",
+                        lambda l=lst, i=i: l[i],
+                        lambda v, l=lst, i=i: l.__setitem__(i, v)))
+    return out
