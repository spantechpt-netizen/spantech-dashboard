+                        -half - snap <= t <= L0 + half + snap and abs(s - half) > 1e-5:
+                    cand.append((abs(s - half), a, u, n, half, t))
+                elif abs(s - half) <= 1e-5 and -half - snap <= t <= L0 + half + snap:
+                    cand.append((0.0, a, u, n, half, t))
