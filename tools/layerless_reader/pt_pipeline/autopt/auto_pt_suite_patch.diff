+def _md_largest(g):
+    if g is None or g.is_empty:
+        return None
+    if g.geom_type == "Polygon":
+        return g
+    parts = [p for p in getattr(g, "geoms", []) if p.geom_type == "Polygon"]
+    return max(parts, key=lambda p: p.area) if parts else None
