+        for d, ang in (("X", base), ("Y", base + _m.pi / 2.0)):
+            have = sum(_L([sp["p1"], sp["p2"]]).intersection(inner).length
+                       for l in lines if l.get("dir") == d for sp in l.get("spans") or [])
