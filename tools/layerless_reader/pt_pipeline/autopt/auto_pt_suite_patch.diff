+               f"regions that had none in that direction (a slab between two "
+               f"step beams, no column inside): "
+               + ", ".join(f"{d} at SE {se:+.0f} ({L:.1f} m)" for d, se, L in added[:6])
+               + ". Check them - they span between the edge beams.")
+    return lines
