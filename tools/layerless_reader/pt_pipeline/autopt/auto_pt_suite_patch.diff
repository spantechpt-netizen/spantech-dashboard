+def _md_trim_beams(site, G):
+    """الكمرة بتتقص على البلاطة. اللي ≥ 50% منها برّه أو أقصر من الحد بتتشال."""
+    P, L, Pt, MP, U = G
+    area = _md_poly(G, site["boundary"]) if site.get("boundary") else None
+    if area is None:
+        slabs = [g for g in (_md_poly(G, s["points"]) for s in site.get("slabs") or []) if g is not None]
+        area = U(slabs) if slabs else None
+    if area is None:
+        return {}
+    loose = area.buffer(0.01, join_style=2)
+    keep, trimmed, dropped = [], 0, []
+    for b in site.get("beams") or []:
+        a, c = tuple(b["p1"]), tuple(b["p2"])
+        L0 = dist(a, c)
+        if L0 < 1e-6:
+            keep.append(b)
+            continue
+        segs = []
+        for zone in (area, loose):        # على الحد بالظبط، ولو فيه فرق تقريب بالتسامح
+            inter = L([a, c]).intersection(zone)
+            segs = [inter] if inter.geom_type == "LineString" else \
+                [g for g in getattr(inter, "geoms", []) if g.geom_type == "LineString"]
+            segs = [s for s in segs if s.length > 0]
+            if segs:
+                break
+        if not segs:
+            dropped.append((b, "outside the slab"))
+            continue
+        s = max(segs, key=lambda g: g.length)
+        if s.length < 0.5 * L0:
+            dropped.append((b, f"{(1 - s.length / L0) * 100:.0f}% outside the slab"))
+            continue
+        if s.length < MIN_MEMBER_LENGTH_M:
+            dropped.append((b, "shorter than the minimum after trimming"))
+            continue
+        q1, q2 = s.coords[0], s.coords[-1]
+        if dist(q1, a) > dist(q2, a):
+            q1, q2 = q2, q1
+        if dist(q1, a) > 0.005 or dist(q2, c) > 0.005:
+            b = dict(b)
+            b["p1"], b["p2"] = (q1[0], q1[1]), (q2[0], q2[1])
+            trimmed += 1
+        keep.append(b)
+    site["beams"] = keep
+    rep = {}
+    if trimmed:
+        rep["beam ends trimmed to the slab"] = trimmed
+    if dropped:
+        rep["beams outside the slab removed"] = len(dropped)
+        site.setdefault("mesh_doctor_dropped", []).extend(
+            {"p1": b["p1"], "p2": b["p2"], "why": w} for b, w in dropped)
+    return rep
+
+
+def _md_close_beam_gaps(site, tol):
+    """
+    طرف الكمرة اللي واقف قبل كمرة/حيطة تانية بأقل من tol بيتمد لمحورها
+    (أو بيتقص لو عدّاه بأقل من tol). ده بيشيل العقد المعلّقة.
+    """
+    mem = _md_members(site)
+    fixed = 0
+    for key, m, a, b, half in mem:
+        if key != "beams":
+            continue
+        L0 = dist(a, b)
+        u = ((b[0] - a[0]) / L0, (b[1] - a[1]) / L0)
+        ends = [list(a), list(b)]
+        for ei in (0, 1):
+            e = ends[ei]
+            best = None
+            for key2, m2, a2, b2, h2 in mem:
+                if m2 is m:
+                    continue
+                L2 = dist(a2, b2)
+                u2 = ((b2[0] - a2[0]) / L2, (b2[1] - a2[1]) / L2)
+                den = u[0] * u2[1] - u[1] * u2[0]
+                if abs(den) < 0.2:
+                    continue
+                k = ((a2[0] - e[0]) * u2[1] - (a2[1] - e[1]) * u2[0]) / den
+                x = (e[0] + u[0] * k, e[1] + u[1] * k)
+                t2 = (x[0] - a2[0]) * u2[0] + (x[1] - a2[1]) * u2[1]
+                if not (-h2 <= t2 <= L2 + h2):
+                    continue
+                if 1e-4 < abs(k) <= tol and (best is None or abs(k) < abs(best[0])):
+                    best = (k, x)
+            if best is not None:
+                ends[ei] = [best[1][0], best[1][1]]
+        if (tuple(ends[0]) != a or tuple(ends[1]) != b) and \
+                dist(ends[0], ends[1]) >= MIN_MEMBER_LENGTH_M:
+            m["p1"], m["p2"] = tuple(ends[0]), tuple(ends[1])
+            fixed += 1
+    return {"beam ends closed onto the member they almost touch": fixed} if fixed else {}
+
