+def _md_openings_and_slivers(site, sliver, G, job):
+    """
+    البلاطة الصافية = الحد − الفتحات. الشرايح اللي أرفع من sliver (بين فتحة
+    والحد أو بين فتحتين) بتتشال، والفتحة اللي لامسة الحد بتبقى تجويف في
+    الحد. الفتحات المتداخلة بتتدمج. الفتحة اللي برّه البلاطة بتتشال.
+    """
+    P, L, Pt, MP, U = G
+    if not site.get("boundary"):
+        return {}
+    B = _md_poly(G, site["boundary"])
+    if B is None:
+        return {}
+    B = _md_largest(B)
+    ops = [g for g in (_md_poly(G, o) for o in site.get("openings") or []) if g is not None]
+    rep = {}
+    outside = [o for o in ops if not o.intersects(B) or o.intersection(B).area < 1e-4]
+    if outside:
+        rep["openings outside the slab removed"] = len(outside)
+    ops = [o for o in ops if o not in outside]
+    R = B.difference(U(ops)) if ops else B
+    h = sliver / 2.0
+    R2 = R.buffer(-h, join_style=2).buffer(h, join_style=2) if h > 0 else R
+    R2 = R2.intersection(R.buffer(1e-6))
+    main = _md_largest(R2)
+    if main is None or main.area < 0.95 * R.area:
+        return rep            # الإصلاح هيشيل أكتر من 5% - مش شريحة
+    lost_islands = [g for g in getattr(R2, "geoms", []) if g is not main and g.area > 0.01]
+    if lost_islands:
+        rep["small islands of slab dropped"] = len(lost_islands)
+    new_b = _md_ring_pts(main.exterior)
+    new_o = [_md_ring_pts(h_) for h_ in main.interiors]
+    if abs(P(new_b).area - B.area) > 1e-4 or len(new_o) != len(site.get("openings") or []):
+        if len(new_o) < len(ops):
+            rep["openings merged or turned into edge notches"] = len(ops) - len(new_o)
+        if R.area - main.area > 1e-4:
+            rep["concrete slivers removed (m²)"] = round(R.area - main.area, 3)
+        site["boundary"] = new_b
+        site["openings"] = new_o
+        fill = P(new_b)
+        slabs = []
+        for s in site.get("slabs") or []:
+            g = _md_poly(G, s["points"])
+            if g is None:
+                continue
+            c = g.intersection(fill)
+            parts = [c] if c.geom_type == "Polygon" else [q for q in getattr(c, "geoms", []) if q.geom_type == "Polygon"]
+            for q in parts:
+                if q.area < 1e-3:
+                    continue
+                s2 = dict(s)
+                s2["points"] = _md_ring_pts(q.exterior)
+                s2["area"] = q.area
+                slabs.append(s2)
+        site["slabs"] = slabs
+        site["drops"] = [s["points"] for s in slabs if s.get("is_drop")]
+        ps = []
+        for st in site.get("pour_strips") or []:
+            g = _md_poly(G, st)
+            c = _md_largest(g.intersection(fill)) if g is not None else None
+            if c is not None and c.area > 1e-3:
+                ps.append(_md_ring_pts(c.exterior))
+        if site.get("pour_strips") is not None:
+            site["pour_strips"] = ps
+    return rep
+
