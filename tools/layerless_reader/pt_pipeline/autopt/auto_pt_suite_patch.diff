+    def _drawing_pipeline(self, src, out, rdir, dwgread, py, job, drop_t=None):
+        import queue as _q
+        proc = None
+        try:
+            env = dict(os.environ)
+            env["PYTHONIOENCODING"] = "utf-8"
+            if dwgread:
+                env["LIBREDWG_DWGREAD"] = dwgread
+            flags = 0x08000000 if os.name == "nt" else 0      # CREATE_NO_WINDOW
+            job.step(0.02, "Checking the drawing reader")
+            chk = subprocess.run(py + ["-c", "import ezdxf, shapely, matplotlib"],
+                                 cwd=rdir, env=env, capture_output=True,
+                                 text=True, creationflags=flags)
+            if chk.returncode != 0:
+                job.error("The drawing reader needs three Python packages. Run "
+                          "once in a command prompt:")
+                job.error(f"    {' '.join(py)} -m pip install ezdxf shapely matplotlib")
+                job.log((chk.stderr or "")[-600:], "error")
+                return
+            job.info(f"Reader: {rdir}")
+            job.info(f"Output: {out}")
+            if drop_t:
+                job.info(f"Drop panels drawn with no thickness written take "
+                         f"{drop_t:g} mm (Project page); a thickness written in "
+                         f"the drawing always wins.")
+            job.step(0.05, "Reading the drawing (a few minutes on a big set)")
+            proc = subprocess.Popen(
+                py + ["-m", "pt_pipeline.convert", src, "-o", out]
+                + (["--drop-thickness", f"{drop_t:g}"] if drop_t else []),
+                cwd=rdir, env=env, stdout=subprocess.PIPE,
+                stderr=subprocess.STDOUT, text=True, encoding="utf-8",
+                errors="replace", creationflags=flags)
+            lines = _q.Queue()
+
+            def _pump():
+                for ln in proc.stdout:
+                    lines.put(ln.rstrip("\n"))
+                lines.put(None)
+
+            threading.Thread(target=_pump, daemon=True).start()
+            tail, frac = [], 0.05
+            while True:
+                if job.cancel_event.is_set():
+                    proc.kill()
+                    raise CancelledError()
+                try:
+                    ln = lines.get(timeout=0.4)
+                except _q.Empty:
+                    continue
+                if ln is None:
+                    break
+                tail = (tail + [ln])[-40:]
+                if ln.startswith("[convert]"):
+                    msg = ln[len("[convert]"):].strip()
+                    frac = min(frac + 0.06, 0.9)
+                    job.step(frac, msg[:80])
+                    (job.warn if "FAIL" in msg or "skipped" in msg
+                     else job.info)(msg)
+            rc = proc.wait()
+            files = sorted(glob.glob(os.path.join(out, "*_slab_clean.dxf")))
+            rep = {}
+            try:
+                with open(os.path.join(out, "report.json"), encoding="utf-8") as f:
+                    rep = json.load(f)
+            except Exception:
+                pass
+            if rc not in (0, 2) or not files:
+                job.error(f"The drawing reader stopped (code {rc}). Last lines:")
+                for ln in tail[-15:]:
+                    job.log("    " + ln, "error")
+                return
+            if rc == 2:
+                job.flag("The zone check FAILED - an element from another zone, "
+                         "an element outside its slab, or a duplicated beam. "
+                         "Check these zones before sending them to RAM:")
+                for ln in rep.get("zone_check") or []:
+                    if "CHECK" in ln or re.search(r"foreign 0 not covered by slab 0 "
+                                                  r"twin beams in zone 0\b", ln):
+                        continue
+                    job.flag("    " + ln)
+            info = self._drawing_zone_info(out, files)
+            n_rev = sum(z["review"] for z in info)
+            job.step(1.0, "Done")
+            job.log("=" * 62, "head")
+            job.ok(f"{len(files)} zone file(s) written to {out}")
+            if n_rev:
+                job.flag(f"{n_rev} item(s) need an engineer's look (REVIEW in "
+                         f"members.csv) - nothing was guessed into the model.")
+            picked = self.bridge.ask(
+                lambda: DrawingZonesDialog(self.root, info, out,
+                                           check_ok=(rc == 0)).show())
+            if not picked:
+                job.warn("No zone was put in the DXF box - the files stay in "
+                         f"{out}.")
+                return
+            self.v["dxf"].set("; ".join(picked))
+            self._last_drawing = picked[0]
+            job.ok(f"{len(picked)} zone file(s) are in the DXF box on the "
+                   f"Project page" + (" - they run one after another (a RAM "
+                                      "model per zone)." if len(picked) > 1
+                                      else "."))
+            self.root.after(0, lambda: self.nav.select("project"))
+        except CancelledError:
+            job.warn("Stopped.")
+        except Exception as e:
+            job.error(f"Reading the drawing failed: {e}")
+            job.log(traceback.format_exc(), "error")
+        finally:
+            if proc is not None and proc.poll() is None:
+                try:
+                    proc.kill()
+                except Exception:
+                    pass
+            self.root.after(0, self._finish)
+
+    @staticmethod
+    def _drawing_zone_info(out, files):
+        """لكل زون: أعدادها من members.csv وصورتها."""
+        counts = {}
+        try:
+            with open(os.path.join(out, "members.csv"), encoding="utf-8-sig") as f:
+                for row in csv.reader(f):
+                    if len(row) < 2 or row[0] == "sheet":
+                        continue
+                    c = counts.setdefault(row[0], {"columns": 0, "walls": 0,
+                                                   "beams": 0, "review": 0})
+                    el = row[1]
+                    if el.startswith("column"):
+                        c["columns"] += 1
+                    elif el == "wall" or el.startswith("wall "):
+                        c["walls"] += 1
+                    elif el == "beam":
+                        c["beams"] += 1
+                    if el == "REVIEW" or "review" in (row[-1] or "").lower():
+                        c["review"] += 1
+        except Exception:
+            pass
+        info = []
+        for p in files:
+            tag = os.path.basename(p)[:-len("_slab_clean.dxf")]
+            c = counts.get(tag, {"columns": 0, "walls": 0, "beams": 0, "review": 0})
+            img = os.path.join(out, "images", tag + ".png")
+            info.append(dict(c, tag=tag, path=p,
+                             image=img if os.path.isfile(img) else None))
+        return info
